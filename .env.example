# Backend ---------------------------------------------------------------
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HTTP_TIMEOUT_S=60
HTTP_MAX_RETRIES=4
FETCH_CHUNK_DAYS=7
# DATA_DIR=/absolute/path/to/data   # defaults to <repo>/data
# Only needed if the UI is served from a different origin than /api, e.g. https://ui.example.com
CORS_ORIGINS=

# Frontend (build time) -------------------------------------------------------
# Leave empty to call the API on the same origin (Vercel, nginx, Vite proxy).
VITE_API_BASE=
# Where `npm run dev` proxies /api to
VITE_PROXY_TARGET=http://localhost:8000
